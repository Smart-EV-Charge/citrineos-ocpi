# Dockerfile.ir - Air-gapped server build.
# Uses Samasha Gitea for Docker images and EVyar Verdaccio for npm packages.
#
# Usage:
#   docker build -f Dockerfile.ir -t citrineos-ocpi .

ARG NODE_IMAGE=git.samasha.ir/evjex/node:22-alpine
ARG NPM_REGISTRY=http://89.42.199.156:4873/

FROM ${NODE_IMAGE} AS build

ARG NPM_REGISTRY
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY}

WORKDIR /usr/local/apps/citrineos-ocpi

RUN npm config set registry "$NPM_REGISTRY" && \
  npm config set audit false && \
  npm config set fund false

COPY . .
COPY ./Server/tsconfig.docker.json /usr/local/apps/citrineos-ocpi/Server/tsconfig.json

RUN npm run install-all
RUN npm run build

FROM ${NODE_IMAGE} AS runtime

WORKDIR /usr/local/apps/citrineos-ocpi

COPY --from=build /usr/local/apps/citrineos-ocpi /usr/local/apps/citrineos-ocpi

EXPOSE 8085

CMD ["npm", "run", "start-docker-cloud"]