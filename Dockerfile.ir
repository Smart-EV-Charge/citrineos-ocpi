# Dockerfile.ir - EV-YAR development deployment build.
# Uses the EV-YAR Gitea registry for Docker images and the internal Verdaccio
# mirror for npm packages. Application source remains unchanged.
#
# Usage:
#   docker build -f Dockerfile.ir -t citrineos-ocpi .

ARG NODE_IMAGE=git.ev-yar.ir/evyar/node:22-alpine
ARG NPM_REGISTRY=http://89.42.199.156:4873/

FROM ${NODE_IMAGE} AS build

ARG NPM_REGISTRY
ENV NPM_CONFIG_REGISTRY=${NPM_REGISTRY}

WORKDIR /usr/local/apps/citrineos-ocpi

RUN npm config set registry "$NPM_REGISTRY" && \
  npm config set replace-registry-host always && \
  npm config set audit false && \
  npm config set fund false

COPY . .
COPY ./Server/tsconfig.docker.json /usr/local/apps/citrineos-ocpi/Server/tsconfig.json

# This OCPI release is coupled to the exact CitrineOS 1.8.0 interfaces in
# package-lock.json. A loose `npm install` resolves ~1.8.0 to newer, breaking
# interface-compatible releases, so keep the deployment build reproducible.
RUN npm ci
RUN npm run build

FROM ${NODE_IMAGE} AS runtime

WORKDIR /usr/local/apps/citrineos-ocpi

COPY --from=build /usr/local/apps/citrineos-ocpi /usr/local/apps/citrineos-ocpi

EXPOSE 8085

CMD ["npm", "run", "start-docker-cloud"]
